# OpenClaw Docker Environment Configuration
# Copy this file to .env and configure your settings

# Node Environment
NODE_ENV=production

# OpenClaw Data Paths
OPENCLAW_HOME=/data/openclaw
OPENCLAW_CONFIG=/data/config

# Gateway Port (default: 18789)
GATEWAY_PORT=18789

# Timezone (adjust to your location)
TZ=UTC

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# API Keys (Optional - can be configured through OpenClaw onboarding wizard)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Resource Limits (adjust based on your Synology NAS)
# Memory limit in GB
MEM_LIMIT=2g
MEM_RESERVATION=512m

# CPU limit (number of CPUs)
CPU_LIMIT=2.0

# Optional: Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-url.com

# Optional: Custom gateway options
# GATEWAY_OPTIONS=--verbose --no-daemon

# VPN Configuration (Surfshark)
# Enable VPN connection before starting OpenClaw
VPN_ENABLED=false

# VPN Type: openvpn or wireguard (currently only openvpn is supported)
VPN_TYPE=openvpn

# Surfshark Service Credentials
# IMPORTANT: These are NOT your Surfshark account credentials!
# Get your service credentials (username and password) from:
# https://my.surfshark.com/vpn/manual-setup/main
# Click on "Manual setup" -> "Service credentials"
# SURFSHARK_USER=your_service_username_here
# SURFSHARK_PASSWORD=your_service_password_here

# Surfshark Country Code
# Choose a country server to connect to (e.g., us, uk, de, nl, jp, au, ca)
# Full list: https://my.surfshark.com/vpn/manual-setup/main
SURFSHARK_COUNTRY=us

# VPN Required
# If true, the container will fail to start if VPN connection fails
# If false, the container will start even if VPN connection fails
VPN_REQUIRED=false
